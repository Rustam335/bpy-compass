# --- Sanity project (public read dataset) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Write token — ONLY for scripts/eval.ts and scripts/seed-api-changes.ts. Never set on Vercel.
SANITY_WRITE_TOKEN=

# --- Sanity Context MCP (server-only) ---
SANITY_ORG_ID=
SANITY_ORG_TOKEN=            # organization token, permission: Context Viewer
SANITY_CONTEXT_MCP_NAME=
SANITY_KNOWLEDGE_BASES=      # optional: comma-separated KB ids to force ?mode=knowledge_base

# --- LLM via OpenRouter (server-only; set a credit limit on this key) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_PROVIDER=         # exact provider name to pin (allow_fallbacks=false)

# --- Local Blender builds for scripts/eval.ts ---
BLENDER_BIN_45=
BLENDER_BIN_50=
